{
  "name": "sitepilot-mcp",
  "version": "0.1.0",
  "description": "Local MCP transport and authentication adapter for the SitePilot WordPress plugin",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jim788e/sitepilot-mcp-npm.git"
  },
  "homepage": "https://github.com/jim788e/sitepilot-mcp-npm#readme",
  "bugs": {
    "url": "https://github.com/jim788e/sitepilot-mcp-npm/issues"
  },
  "type": "module",
  "bin": {
    "sitepilot-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@instantbuild-sitepilot/contracts": "^1.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
